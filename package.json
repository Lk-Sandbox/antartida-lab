{
  "name": "antartida-lab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @antartida/preact-vite dev",
    "build": "pnpm --filter @antartida/preact-vite build",
    "preview": "pnpm --filter @antartida/preact-vite preview",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "e2e": "pnpm --filter @antartida/preact-vite e2e",
    "coastline": "pnpm --filter @antartida/core coastline",
    "map-raster": "pnpm --filter @antartida/core map-raster",
    "bench": "pnpm --filter @antartida/bench bench"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "26.6.6"
  }
}
